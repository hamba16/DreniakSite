# Canonical public URL; set to the preview origin while testing forms on a preview.
NEXT_PUBLIC_SITE_URL=https://dreniak.com
# Supabase project used for authentication and data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. GA4 loads only after the visitor opts in.
NEXT_PUBLIC_GA_ID=
# Server-only SMTP. Use a provider approved by Hamba; recipient stays info@dreniak.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Newsletter: select either an authenticated HTTPS storage webhook or an absolute
# directory on a persistent server volume. Do not use ephemeral serverless storage.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
NEWSLETTER_DATA_DIR=
# Only enable when the host overwrites x-forwarded-for with a trusted client IP.
TRUST_PROXY=false
