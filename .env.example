# Canonical public URL; set to the preview origin while testing forms on a preview.
NEXT_PUBLIC_SITE_URL=https://dreniak.com
# Supabase project used for CMS data and encrypted admin authentication storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Add to the appropriate Vercel environment; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Exactly 32 random bytes, base64 encoded. Back up securely; keep stable.
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_MASTER_KEY=
# Optional. GA4 loads only after the visitor opts in.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
# Set false to hide newsletter capture until production storage is verified.
NEXT_PUBLIC_NEWSLETTER_ENABLED=true
# Server-only SMTP. Use a provider approved by Hamba; recipient stays info@dreniak.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Newsletter provider. Buttondown is the production default; legacy adapters remain
# available with NEWSLETTER_PROVIDER=webhook or NEWSLETTER_PROVIDER=filesystem.
NEWSLETTER_PROVIDER=buttondown
BUTTONDOWN_API_KEY=
BUTTONDOWN_API_BASE_URL=https://api.buttondown.email/v1
# Set the same long random signing key in Buttondown's unsubscribe webhook.
# Endpoint: https://your-domain/api/webhooks/buttondown
BUTTONDOWN_WEBHOOK_SIGNING_KEY=
# memory for one process; supabase for multiple instances/serverless.
# Apply all checked-in migrations before selecting supabase. Store errors fail closed.
RATE_LIMIT_STORE=memory
# Legacy adapters: do not use filesystem storage on serverless deployments.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_DATA_DIR=
# Only enable when the host overwrites x-forwarded-for with a trusted client IP.
TRUST_PROXY=false
